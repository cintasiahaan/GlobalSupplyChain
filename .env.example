APP_NAME="Global Supply Chain"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =====================================================
# DATABASE - Diisi otomatis oleh Railway MySQL Plugin
# =====================================================
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

# =====================================================
# EXTERNAL API KEYS (ISI DI RAILWAY ENVIRONMENT VARS)
# =====================================================
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WORLD_BANK_API_URL=https://api.worldbank.org/v2/country
REST_COUNTRIES_API_URL=https://restcountries.com/v3.1/name
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
GNEWS_API_URL=https://gnews.io/api/v4/search
GNEWS_API_KEY=

# MAP & GEOSPATIAL
LEAFLET_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
